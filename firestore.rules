rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /answers/{answerId} {
        allow write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          isAdmin() ||
          (request.auth.uid < userId && exists(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + userId))) ||
          (userId < request.auth.uid && exists(/databases/$(database)/documents/connections/$(userId + '_' + request.auth.uid)))
        );
      }

      match /customQuestions/{packId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /progress/{progressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /connections/{connectionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /responses/{responseId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if request.auth != null &&
        (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid);
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if isAdmin();
    }

    match /activity/{activityId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if isAdmin();
    }

    match /partners/{partnerId} {
      allow create, read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if false;
    }

    match /connections/{connectionId} {
      allow create: if request.auth != null && (isAdmin() || request.auth.uid in request.resource.data.users);
      allow read: if request.auth != null && (isAdmin() || request.auth.uid in resource.data.users);
      allow update: if request.auth != null && (isAdmin() || request.auth.uid in resource.data.users);
      allow delete: if request.auth != null && (isAdmin() || request.auth.uid in resource.data.users);
    }

    match /connection_requests/{requestId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId;
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow update: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.toUserId
      );
      allow delete: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
    }

    match /analytics_full_reports/{reportId} {
      allow create: if request.auth != null && isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /userAnswers/{docId} {
      allow read, write: if request.auth != null && (request.auth.uid == docId || isAdmin());
    }

    match /partnerConnections/{connectionId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null || isAdmin();
      allow delete: if request.auth != null;
    }

    match /audit_log/{logId} {
      allow create: if request.auth != null && isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}

    // ========================================
    // ANALYTICS ANSWERS COLLECTION
    // Respostas anónimas para analytics
    // ========================================
    match /analytics_answers/{answerId} {
      // Qualquer pessoa pode criar (respostas anónimas)
      allow create: if true;
      
      // Apenas admins podem ler
      allow read: if isAdmin();
      
      // Ninguém pode editar ou apagar
      allow update, delete: if false;
    }
    
    // ========================================
    // PUBLIC STATISTICS COLLECTION
    // Estatísticas públicas para a página de estatísticas
    // Atualização: 7h e 19h (pelo admin)
    // ========================================
    match /publicStatistics/{docId} {
      // LEITURA: Qualquer pessoa pode ler (público)
      allow read: if true;
      
      // ESCRITA: Apenas admins podem publicar estatísticas
      allow write: if isAdmin();
    }
    
    // ========================================
    // QUEST4YOU - USER PROFILES
    // ========================================
    match /quest4you_users/{userId} {
      // Utilizador pode ler/escrever o seu próprio perfil
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ========================================
    // QUEST4YOU - QUIZ RESULTS
    // ========================================
    match /quest4you_results/{resultId} {
      // Utilizador pode escrever os seus próprios resultados
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && 
                                     resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // QUEST4YOU - PUBLIC PROFILES (Smart Match)
    // ========================================
    match /quest4you_public/{profileId} {
      // Qualquer utilizador autenticado pode ler perfis públicos
      allow read: if request.auth != null;
      // Utilizador só pode criar/editar o seu próprio perfil público
      allow create: if request.auth != null && request.auth.uid == profileId;
      allow update, delete: if request.auth != null && request.auth.uid == profileId;
    }
      // ========================================
    // BLOG COMMENTS COLLECTION
    // Comentários públicos dos artigos do blog
    // ========================================
    match /blog_comments/{articleId} {
      // Qualquer pessoa pode ler o documento do artigo
      allow read: if true;
      // Permitir criação implícita do documento do artigo
      allow create: if true;
        match /comments/{commentId} {
        // LEITURA: Qualquer pessoa pode ler comentários (público)
        allow read: if true;
        
        // CRIAÇÃO: Qualquer pessoa pode criar comentários
        allow create: if true;
        
        // ATUALIZAÇÃO: Qualquer pessoa pode dar like (atualizar likes/likedBy/replies)
        allow update: if true;
        
        // ELIMINAÇÃO: Apenas admins podem eliminar comentários
        allow delete: if isAdmin();
      }
    }
    
    // ========================================
    // BLOQUEAR TUDO O RESTO
    // ========================================
    // Qualquer outra coleção não especificada acima é bloqueada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
